# Copy this file to .env and fill in the values. .env is git-ignored; never commit it.

# --- Legacy TMS (TCP socket, fixed-width protocol) — from the "credentials provided separately" email
TMS_HOST=
TMS_PORT=
TMS_AUTH_TOKEN=
# Staging demo fault switch only (D-030): off, down, timeout, or garbage.
TMS_FAULT_MODE=off
TMS_TIMEOUT_MS=1200
TMS_MAX_ATTEMPTS=4
# Channels a one-time code may go by: email, or sms;email once an SMS sender exists (D-023).
CODE_CHANNELS=email

# --- FMCSA QCMobile API — free webKey from https://mobile.fmcsa.dot.gov/QCDevsite/
FMCSA_WEB_KEY=

# --- HappyRobot platform (only needed if the backend calls the platform API directly;
#     the MCP servers in .mcp.json authenticate via OAuth instead)
HAPPYROBOT_API_KEY=
HAPPYROBOT_CLUSTER=us
# Least-privilege key for writing call records to Twin: role "Twin writer" (Insert + Update Twin data only). Staging only here;
# the production key lives only in Secret Manager (D-018).
TWIN_WRITER_API_KEY=
# Read-only Twin key for the ops dashboard's reads: role with read access only (D-026). Never used to write.
TWIN_READER_API_KEY=

# --- Twin gateway (Settings → Twin Database → API gateway). Not secret; the org ID only routes requests.
TWIN_GATEWAY_URL=
TWIN_ORG_ID=

# --- Service authentication: OAuth2 client credentials (D-016). STAGING values only.
#     Production secrets are created inside Secret Manager by deploy.sh and never stored here (D-018).
#     Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
OAUTH_CLIENT_ID=happyrobot
OAUTH_CLIENT_SECRET=
# Keyed hash for one-time codes (D-008). Staging only; production is created in Secret Manager.
OTP_HASH_KEY=
OAUTH_SIGNING_KEY=
# OAuth client for the ops dashboard (D-027): its own id and secret, scope 'ops'.
OPS_CLIENT_ID=ops-dashboard
OPS_CLIENT_SECRET=

# --- Deployment target (fill in whichever cloud you pick)
CLOUD_PROVIDER=
CLOUD_REGION=
GCP_PROJECT_ID=
